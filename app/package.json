{
  "name": "kazzly-library",
  "version": "1.0.0",
  "description": "Kazzly Library para escritorio",
  "author": "Kazzly <byronandres201112@gmail.com>",
  "main": "main.js",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.kazzly.library",
    "productName": "Kazzly Library",
    "files": ["main.js", "offline.html"],
    "win": {
      "target": "nsis",
      "artifactName": "Kazzly-Library-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "artifactName": "Kazzly-Library-${version}.${ext}"
    }
  }
}
